{
	funcao inicio()
	{
		
		inteiro vetor[10] = {5, 12, 8, 23, 8, 4, 15, 8, 9, 11} 
		inteiro numeroProcurado
		inteiro contador = 0

		
		escreva("Digite um número para buscar no vetor: ")
		leia(numeroProcurado)

		para (inteiro i = 0; i < 10; i++)
		{
			se (vetor[i] == numeroProcurado)
			{
				escreva("Número encontrado na posição: ", i, "\n")
				contador++
			}
		}

				se (contador == 0)
		{
			escreva("O número ", numeroProcurado, " não está presente no vetor.")
		}
		senao
		{
			escreva("O número apareceu ", contador, " vez(es).")
		}
	}
}
